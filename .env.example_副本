# AI Provider: "openai" or "anthropic"
# 使用 Qwen、DeepSeek 等兼容服务时也设置为 openai
AI_PROVIDER=openai

# OpenAI / 兼容 OpenAI 格式的服务（如阿里云百炼 Qwen、Moonshot、DeepSeek 等）
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# 阿里云百炼 Qwen 配置（如需使用 Qwen，取消下方注释并修改）
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-你的百炼 API Key
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
